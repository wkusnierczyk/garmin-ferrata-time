# Ferrata Demo (#140): the app's source and resources, its own manifest (its own app id and name,
# the same products), playing the made-up climb on the bundled route and never recording. Layered
# over monkey.jungle, and always last:
#
#   monkeyc -f "monkey.jungle;demo.jungle" ...    (make build DEMO=1)
#
# Never with replay.jungle: the replay stands in for the sensors, which the demo does not read.

project.manifest = manifest-demo.xml

# APPEND, never replace. (:nodemo) is the app's side of Feed's choice of input (source/Feed.mc); the
# demo keeps (:demo).
base.excludeAnnotations = $(base.excludeAnnotations);nodemo

# Ferrata Demo's launcher icons (#149): the app's climber with a white outline, to tell the two apps
# apart in the launcher, drawn by tools/launcher_icon.py's render_demo into demo/resources-icon-<size>/.
# One entry per product, appended after the one monkey.jungle gives it, so the demo's
# resources-icon-<size> is the later directory and its LauncherIcon wins. The entries are relative
# to this file's directory, which is how monkeyc resolves them. No fallback of its own: a product
# that monkey.jungle maps and this block does not would get the app's icon, and make check-icons
# reports it as unmapped. Regenerate with make icons, which redoes both apps' icons.
# BEGIN generated launcher icon mapping -- garmin-graphics-generator
# Launcher icon size is per device, not per device family.
# Regenerate with: garmin-graphics-generator icons -R tools/launcher_icon.py:render_demo --manifest manifest-demo.xml --jungle demo.jungle --icon-root demo --no-fallback-icon
approachs7042mm.resourcePath = $(approachs7042mm.resourcePath);demo/resources-icon-60
approachs7047mm.resourcePath = $(approachs7047mm.resourcePath);demo/resources-icon-70
approachs7243mm.resourcePath = $(approachs7243mm.resourcePath);demo/resources-icon-60
