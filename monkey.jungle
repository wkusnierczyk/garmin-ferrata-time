# One edition, the products in manifest.xml (README, Devices). The Lite/Premium split comes with the real app.
project.manifest = manifest.xml

# Strict typing from the first line (playbook, reference/build.md).
project.typecheck = 3

# Name the source directory: the default globs .dev/ too.
base.sourcePath = source

# The replay (#57) is left out: its recording and the code that loads it are only in the replay build,
# replay.jungle layered over this file (make run REPLAY=1), which swaps this exclusion for its opposite.
# replay.jungle replaces this list rather than appending to it: keep it in step with any exclusion
# added here.
base.excludeAnnotations = replay

# No base.resourcePath here: the default, resources. replay.jungle names it again with its own folder
# added; keep that in step if one is set here.
